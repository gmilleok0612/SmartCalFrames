<UserControl x:Class="SmartCalFrames.Options.SmartCalOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="420">
    <UserControl.Resources>
        <!-- Same fix as the dockable panel (SmartCalFramesView.xaml): NINA applies its own
             application-wide implicit style to every plain <CheckBox>, which replaces the normal
             square-box-plus-label look with a toggle-switch template that only shows static "ON"/"OFF"
             text and never renders the CheckBox's own Content property. That's why "Write run log to a
             file" showed up as an unlabeled toggle with no visible text - not a binding problem, just
             this ambient NINA style silently taking over. This local Style restores a real checkbox
             with a visible checkmark; the "Log" label below is a separate TextBlock next to it (not the
             CheckBox's own Content) so it's unambiguous either way. -->
        <Style x:Key="SmartCalCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="15" Height="15" Background="#FF1A2226"
                                BorderBrush="#FF7C8A93" BorderThickness="1" VerticalAlignment="Center">
                            <Path x:Name="CheckMark" Data="M 1,5 L 5,9 L 13,1" Stroke="White"
                                  StrokeThickness="2" Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="Background" Value="#FF273238"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="8">
        <TextBlock Text="Smart Calibration Frames" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

        <TextBlock Text="Target ADU (% of full well)" Margin="0,4,0,0"/>
        <TextBox Text="{Binding TargetADUPercent}" Width="80" HorizontalAlignment="Left"/>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,2,0,0">
            <Run Text="How bright you want each flat frame to be, as a percentage of your camera's maximum possible pixel value (its &quot;full well&quot;). 50% is a reasonable starting point for most cameras if you don't already have a preferred target. Whole percent, 1-99."/>
        </TextBlock>

        <TextBlock Text="Tolerance (%)" Margin="0,4,0,0"/>
        <TextBox Text="{Binding ToleranceADUPercent}" Width="80" HorizontalAlignment="Left"/>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,2,0,0">
            <Run Text="How close a captured frame's brightness has to land to Target ADU, as a percentage of the target, before it's accepted. For example, 10 accepts anywhere from 90% to 110% of target. A smaller number gives more precisely-matched frames but may take longer to reach; a larger number finishes faster but with more variation between frames. Whole percent, 1-100."/>
        </TextBlock>

        <TextBlock Text="Min / Max exposure (seconds)" Margin="0,8,0,0" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal">
            <TextBox Text="{Binding MinExposureSeconds, StringFormat=F2}" Width="70"/>
            <TextBlock Text=" to " VerticalAlignment="Center"/>
            <TextBox Text="{Binding MaxExposureSeconds, StringFormat=F2}" Width="70"/>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,2,0,0">
            <Run Text="The shortest and longest exposure time the plugin is allowed to use while adjusting exposure to hit Target ADU for a filter (brightness stays fixed per filter - see Per-Filter Defaults below). If a filter can't reach target within this range, that filter's run stops and reports a failure. When that happens, the usual fix is to adjust that filter's Brightness in Per-Filter Defaults, not these bounds."/>
        </TextBlock>

        <TextBlock Text="Min / Max brightness (allowed range)" Margin="0,8,0,0" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal">
            <TextBox Text="{Binding MinBrightness}" Width="70"/>
            <TextBlock Text=" to " VerticalAlignment="Center"/>
            <TextBox Text="{Binding MaxBrightness}" Width="70"/>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,2,0,0">
            <Run Text="Each filter normally runs at one fixed brightness (set in Per-Filter Defaults below) - Min Brightness here also doubles as the starting brightness for a filter that has never been run before. If exposure alone can't reach Target ADU within the Min/Max Exposure range above (too dim even at the longest allowed exposure, or too bright even at the shortest), the plugin will also try nudging brightness toward whichever of these two bounds helps, before giving up. Widen this range to give it more room to recover. The two boxes keep Min at or below Max automatically, and both are limited to the panel's real 0-255 range."/>
        </TextBlock>

        <TextBlock Text="Starting exposure for a new filter (seconds)" Margin="0,8,0,0" FontWeight="SemiBold"/>
        <TextBox Text="{Binding PreferredExposureSeconds, StringFormat=F2}" Width="80" HorizontalAlignment="Left"/>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,2,0,0">
            <Run Text="The exposure time used the very first time a filter is run, before it has ever converged on its own value. This matters most if your camera generally needs longer exposures than a short default (common for CCD cameras) - a too-short first test exposure can be too noisy to give the search a reliable starting point. Set this close to what you already expect this camera/panel combination to need. Min/Max Exposure above are unchanged - they still limit what the search is allowed to do; this only changes where it starts. Once a filter has converged for real, its own saved exposure (Per-Filter Defaults below) is used instead. To lock every filter to one exact exposure with no automatic adjustment, set Min and Max Exposure above to the same number - the same idea as Min/Max flats per filter below."/>
        </TextBlock>

        <TextBlock Text="Panel settle time after brightness change (ms)" Margin="0,8,0,0"/>
        <TextBox Text="{Binding PanelSettleTimeMs}" Width="80" HorizontalAlignment="Left"/>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,2,0,0">
            <Run Text="How long to wait, in milliseconds, after telling the panel to change brightness before taking the next exposure - gives the panel's light time to stabilize so the frame isn't captured mid-change."/>
        </TextBlock>

        <TextBlock Text="Min / Max flats per filter" Margin="0,8,0,0" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal">
            <TextBox Text="{Binding MinFlatsPerFilter}" Width="70"/>
            <TextBlock Text=" to " VerticalAlignment="Center"/>
            <TextBox Text="{Binding MaxFlatsPerFilter}" Width="70"/>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,2,0,0">
            <Run Text="Not a fixed count - a floor and a ceiling around an automatic stopping check. Min: never consider a filter's flats done with fewer than this many accepted frames, even if they already look consistent. Max: always stop by this many attempts, even if the frames never settle down or keep getting rejected - so one bad night can't run forever. Exactly how many frames get taken, somewhere between Min and Max, depends on Stack Stability Threshold and Frame Outlier Tolerance below. Want exactly N flats every time with none of this automatic behavior? Set Min and Max to the same number."/>
        </TextBlock>

        <TextBlock Text="Stack stability threshold (%)" Margin="0,8,0,0" FontWeight="SemiBold"/>
        <TextBox Text="{Binding StackStabilityThreshold}" Width="80" HorizontalAlignment="Left"/>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,2,0,0">
            <Run Text="Decides when the accepted frames as a GROUP are consistent enough to stop capturing (once at least Min flats per filter, above, have been taken). It measures how much the accepted frames' brightness varies from each other, as a percentage of their average. Once that variation drops below this number, capture stops. Default 1 means: stop once the group is consistent within 1%. Lower = more consistent results but more frames taken to get there; higher = stops sooner but accepts more frame-to-frame variation. This only decides when to STOP - it never throws out an individual frame; see Frame Outlier Tolerance below for that. Whole percent, 0-100."/>
        </TextBlock>

        <TextBlock Text="Frame outlier tolerance (%)" Margin="0,8,0,0" FontWeight="SemiBold"/>
        <TextBox Text="{Binding FrameOutlierTolerancePercent}" Width="80" HorizontalAlignment="Left"/>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,2,0,0">
            <Run Text="Checks each NEW frame by itself, right after it's taken: if it differs too much from the average of the frames already accepted (for example, a passing satellite trail or a brief panel glitch), it's thrown out and another frame is captured in its place instead. Rejected frames are never saved and don't count toward Min/Max Flats Per Filter above. Default 5 means: reject a frame more than 5% off the running average. This only applies to a real flat panel with steady output - don't use it for sky flats, where the sky's brightness is expected to drift during a session and this check would wrongly reject good frames for following that trend. Whole percent, 0-100."/>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <TextBlock Text="Log:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <CheckBox IsChecked="{Binding LogToFileEnabled}" Style="{StaticResource SmartCalCheckBoxStyle}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,2,0,0">
            <Run Text="When on, everything shown in the on-screen run log (search attempts, captured frames, rejections, and the final summary for each filter) is also saved to a text file as the run happens - handy for reviewing an unattended overnight run afterward. A new file is started each time a run begins."/>
        </TextBlock>
        <TextBlock Text="Run log folder:" Margin="0,6,0,0" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding LogFileFolder}" TextWrapping="Wrap" Opacity="0.7" FontSize="11"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <TextBlock Text="Pause for cover swap:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <CheckBox IsChecked="{Binding PauseForCoverSwap}" Style="{StaticResource SmartCalCheckBoxStyle}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,2,0,0">
            <Run Text="For a panel with no motorized cover (a plain manual panel, or none at all): when on, capturing Flat Frames pauses and waits for you to click Continue TWICE - once right before capture starts (time to remove the cap and put the panel in place) and once right after it finishes (time to remove the panel and put the cap back on before Flat Darks/Bias/Dark Frames run). Applies to the dockable panel's Flats button, the Run All batch, and the Advanced Sequencer instruction's Flat Frames function alike. Leave this OFF if your panel has a real motorized cover - the automatic open/close guard already handles that hardware with no manual step. Works the same way whether or not the dockable panel has ever been opened this NINA session - a sequence run always shows its own pop-up dialog."/>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <TextBlock Text="Open cover after run complete:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <CheckBox IsChecked="{Binding OpenCoverAfterRun}" Style="{StaticResource SmartCalCheckBoxStyle}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,2,0,0">
            <Run Text="For a MOTORIZED flat-panel cover only. This plugin always closes the cover before capturing, for a light-sealed frame. Off (default): once a run ends, the cover stays closed until you open it yourself. On: the cover is reopened automatically once the run finishes (single capture, Run All batch, or the sequencer item). Has no effect on a panel with no motorized cover, and is unrelated to Pause for cover swap above - that setting is about a manual panel/cap swap, this one is about what a motorized cover does after a run."/>
        </TextBlock>

        <TextBlock Text="Per-filter defaults" Margin="0,10,0,0" FontWeight="Bold"/>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,2,0,0">
            <Run Text="Each filter remembers exactly one brightness and one exposure. Set these to a reasonable starting point for each filter (for example, a short exposure for a broadband filter, a longer one for narrowband). When you run a filter, it's captured at these two values; if the result is outside Tolerance (above), exposure alone is adjusted (brightness never changes automatically) to bring it on target, within Min/Max Exposure. If it succeeds, these two values are automatically updated to whatever actually worked, so they stay accurate without you needing to maintain them by hand. If it can't reach target within Min/Max Exposure, nothing is saved for that filter and the run log reports a failure - in that case, try adjusting this filter's Brightness (most likely too high or too low) and run it again."/>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding FilterDefaults}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                        <TextBlock Text="{Binding FilterName}" Width="90" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text="Brightness:" VerticalAlignment="Center" Margin="6,0,4,0"/>
                        <TextBox Text="{Binding Brightness, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        <TextBlock Text="Exposure (s):" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        <TextBox Text="{Binding ExposureSeconds, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
