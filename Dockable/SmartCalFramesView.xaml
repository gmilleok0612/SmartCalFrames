<UserControl x:Class="SmartCalFrames.Dockable.SmartCalFramesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:util="clr-namespace:SmartCalFrames.Utility"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" d:DesignWidth="380">
    <UserControl.Resources>
        <util:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <!-- ROUND 44 - Run Flats tab's "Frames per filter" simple control / Adaptive (advanced) reveal.
             BooleanToVisibilityConverter is a standard built-in WPF class (System.Windows.Controls,
             PresentationFramework) - already covered by the default presentation xmlns above, no extra
             namespace import needed. InverseBooleanToVisibilityConverter already existed in this
             project (Utility/InverseBooleanToVisibilityConverter.cs), previously used only by the
             sequencer's compact editor. -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <util:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <!-- ROUND 69 - image-preview column (Options page "Show captured image" toggle). See
             Utility/BoolToGridLengthConverter.cs for why a plain Visibility binding on the column's
             CONTENT isn't enough to actually give the log its full width back when this is off. -->
        <util:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter"/>

        <!-- ROUND 39 - Dark Frames tab's per-row Binning dropdown (tab renamed same session from "Light
             Darks" per explicit user feedback). A plain 1x-5x list ("no reason to go farther than that"
             per explicit direction) - a static x:Array is simplest here since every row's ComboBox needs
             the exact same fixed item list, with no need to reach back to a parent VM property through a
             RelativeSource binding. -->
        <x:Array x:Key="BinningOptions" Type="sys:Int32">
            <sys:Int32>1</sys:Int32>
            <sys:Int32>2</sys:Int32>
            <sys:Int32>3</sys:Int32>
            <sys:Int32>4</sys:Int32>
            <sys:Int32>5</sys:Int32>
        </x:Array>

        <!-- ROUND 36 FIX - reported: "when I click on Flat Darks, I lose the run for filters and can't
             figure out how to go back to that window." Root cause: a plain WPF TabControl/TabItem has no
             NINA styling applied to it at all - unlike the RunLog ListBox below (already given an
             explicit dark-theme override for the same reason back when this panel was first built), the
             TabControl added in this round was left with WPF's default light-theme tab header rendering,
             which goes low-contrast-to-invisible against NINA's dark background. The "Run" tab was never
             actually gone - there was just nothing visible to click to get back to it. Explicit
             ControlTemplate below gives both tab headers NINA's own dark palette (#273238 base, #3E4B54
             selected - the exact colors already sampled from NINA for the RunLog ListBox), so the
             inactive tab is always visible and obviously clickable. -->
        <Style x:Key="SmartCalTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="#FF1A2226" BorderBrush="#FF3E4B54" BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF3E4B54"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF2F3B42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ROUND 46 FIX - reported after the tab-visibility fix: "your fix is not what it is supposed to
             look like" - a real screenshot of the live panel showed the Run All strip's four checkboxes
             rendering as unlabeled ON/OFF toggle-switch pills, with no "Flats"/"Flat Darks"/"Bias
             Frames"/"Dark Frames" text anywhere. Root cause: NINA applies its own APPLICATION-WIDE
             implicit style to every plain <CheckBox> (keyed by TargetType, not by x:Key, so it applies
             silently with no local Style reference needed) - the same style behind NINA's own equipment
             "Connected" toggles - which replaces the normal square-box-plus-label template with a
             toggle-switch template that only ever shows static "ON"/"OFF" text and never renders the
             Content property at all. Every <CheckBox> added to this file was silently swallowed by that
             ambient style; nothing in our own bindings was wrong, the rendering just wasn't the labeled
             checkbox row that was actually asked for ("similar to a sequence instruction").

             Fix, same pattern as the Round 36 TabItem style override above (NINA's ambient styling
             doesn't match what this panel needs, so give it an explicit local Style instead of relying on
             app-wide defaults): a self-contained ControlTemplate - a plain square box that fills with a
             checkmark when checked, plus a real ContentPresenter so the label text actually shows.
             Applied to every CheckBox in this file: the four Run All checkboxes below AND the Round 44
             "Adaptive (advanced)" checkbox on the Run Flats tab, which had the exact same latent defect -
             just not yet reported, since this is the first time the whole panel has been visible in live
             NINA since the Round 45 layout change (the tab itself was hidden by the docking-layout issue
             until just now). -->
        <Style x:Key="SmartCalCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="15" Height="15" Background="#FF1A2226"
                                    BorderBrush="#FF7C8A93" BorderThickness="1" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M 1,5 L 5,9 L 13,1" Stroke="White"
                                      StrokeThickness="2" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"
                                               TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                        <!-- ROUND 47 - checkmark/border changed from blue (#FF3EA6FF) to White per
                             explicit feedback: blue clashed against the Run All strip's green button
                             background once that strip's Border background changed to the grey
                             "selected" color (#FF3E4B54) - White reads cleanly against both. -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="Background" Value="#FF273238"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ROUND 49 (REVERTED in ROUND 50) - tried giving All/None/Run Selected/Stop a flat dock-tab-
             style look (#FF1A2226 base). Reported back: "the background is still black is that
             intentional on these buttons-they should be green." NINA's own DEFAULT Button chrome is
             already green when enabled (visible in the user's own screenshot earlier this session) -
             overriding it with the flat grey template actually broke consistency with NINA's interface
             rather than improving it, since these are ACTION buttons (NINA renders those green), not
             dock-tab headers (which NINA renders in the dark grey this style used). Style removed below
             and the four buttons now use NINA's own ambient default Button style again - no local
             Style="..." reference at all, same as every other capture button already in this file
             (Capture flat darks, Preview groups, etc.), all of which were always left at NINA's default
             and never reported as wrong. -->
    </UserControl.Resources>
    <!-- ROUND 65 - the shared RunLog area below the TabControl (Grid.Row="4" as of Round 84 - was "3"
         before that round added the StatusText+histogram row above the Separator) is a "*" row, so it only
         ever gets whatever height is left over after the "Auto" rows above it (checkbox strip, TabControl,
         StatusText+histogram row, separator) take what THEY need. Reported: the log appeared not to display
         at all
         with the Dark Frames tab selected - that tab is the only one of the four with both the longest
         description text AND a per-filter Binning/Frames/Exposure table (up to 220px tall, see the
         ScrollViewer below), so on a docked panel that isn't very tall, its Auto-sized content could
         consume all the available height and leave the "*" row nothing, while the other three
         (shorter-content) tabs still left the log some room. Dark Frames WAS logging the whole time
         (RunDarkFramesAsync appends to RunLog exactly like the other three run methods) - this was pure
         layout starvation, not a missing/skipped log. Fixed with MinHeight on the "*" row below so the
         log area can never be squeezed to nothing, and by shrinking the Dark Frames per-filter table's
         own MaxHeight (220 -> 140) so it demands less room to begin with. -->
    <Grid Margin="8">
        <!-- ROUND 84 - added a fifth row (was four: strip/TabControl/Separator/log-image). The shared
             StatusText+histogram row now lives at Grid.Row="2", ABOVE the Separator - "I wanted the
             histograms to go above the horizontal line above the log, as was in the previous dark frame
             window" - matching how Round 80's Dark Frames tab had its own histogram above the separator,
             next to its table, while only the log/image sat below it. Separator moves down to Grid.Row="3"
             and the log/image Grid moves down to Grid.Row="4". See the Round 84 comment on the new row
             itself, further down, for the rest of this change. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- ROUND 67 - "Pause for cover swap" banner (Grid.Row="1"), collapsed to zero height via
                 its own Visibility binding whenever no pause is in progress - see that Border below.
                 Restored here alongside the Round 73+ StatusText/histogram/image-preview rows after
                 this row was lost from an earlier snapshot of this file (all rows below it shift down
                 by one accordingly: StatusText/histogram Grid.Row="1"->"2", TabControl "2"->"3",
                 Separator "3"->"4", log/image Grid "4"->"5"). -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="140"/>
        </Grid.RowDefinitions>

        <!-- ROUND 43 - "Run All" strip: queues and runs any combination of Flats/Flat Darks/Bias
             Frames/Dark Frames with one click, each using whatever is already configured on its own
             tab below (see SmartCalFramesVM.RunSelectedBatchAsync for the full design - fixed order,
             per-item failure doesn't abort the queue, Stop cancels the whole thing). Deliberately
             placed above the TabControl rather than as a fifth tab, since it's meant to work no matter
             which tab happens to be selected, not compete with them for the same space.

             ROUND 45 - REVISED per explicit user feedback: single horizontal line - checkboxes and
             buttons together, left to right - matching how NINA's own Advanced Sequencer instructions
             lay out an inline row of checkboxes. Wrapped in a horizontal-only ScrollViewer (not a
             WrapPanel) so the line never wraps to a second row - it scrolls sideways instead.

             ROUND 47 - REVISED again per explicit user feedback on a real screenshot:
             - Deleted the "Run All" label text (was the first child of a wrapping StackPanel, upper-
               LEFT corner of the border) - redundant once this is the only thing in the border, so the
               ScrollViewer is now the Border's direct child and the wrapping StackPanel is gone.
             - Background changed from #FF1A2226 to #FF3E4B54 (the same grey already used elsewhere in
               this file for a tab's SELECTED state - see SmartCalTabItemStyle above - reusing an
               already-established "selected" color rather than picking a new one).
             - Padding reduced from 8 to 4,3 now that there's no separate label row above the checkboxes
               to leave headroom for.
             - All/None/Run Selected/Stop buttons: FontSize bound to the first checkbox's actual
               rendered FontSize (ElementName binding, not a guessed pixel value) so they visually match
               the surrounding checkbox/label text instead of inheriting NINA's own (larger) default
               Button font size.

             ROUND 48 CORRECTION - "Frames per filter"/"Adaptive (advanced)" were relocated HERE in
             Round 47, but that wasn't the actual ask ("where did adaptive go... my idea was to simply
             move the number of filters and adaptive to the right side of the Filter above it") - the
             real intent all along was the Run Flats TAB's own "Filter:" row, not this strip. Moved back
             out to the Run Flats tab below (see that TabItem's Grid.Row="0"). Also switched from a
             horizontal-only ScrollViewer to a WrapPanel per explicit request ("make the line with the
             checkboxes wrap instead of a scroll bar") - a WrapPanel lets the strip drop to a second
             line on a narrow docked panel instead of requiring a horizontal scrollbar. -->
        <Border Grid.Row="0" Margin="0,0,0,8" Padding="4,3" Background="#FF3E4B54" BorderBrush="#FF3E4B54" BorderThickness="1">
            <WrapPanel Orientation="Horizontal">
                <CheckBox x:Name="RunAllFlatsCheckBox" Content="Flats" IsChecked="{Binding RunFlatsSelected}"
                          Style="{StaticResource SmartCalCheckBoxStyle}"
                          IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                          VerticalAlignment="Center" Margin="0,0,14,4"/>
                <CheckBox Content="Flat Darks" IsChecked="{Binding RunFlatDarksSelected}"
                          Style="{StaticResource SmartCalCheckBoxStyle}"
                          IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                          VerticalAlignment="Center" Margin="0,0,14,4"/>
                <CheckBox Content="Bias Frames" IsChecked="{Binding RunBiasSelected}"
                          Style="{StaticResource SmartCalCheckBoxStyle}"
                          IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                          VerticalAlignment="Center" Margin="0,0,14,4"/>
                <CheckBox Content="Dark Frames" IsChecked="{Binding RunDarkFramesSelected}"
                          Style="{StaticResource SmartCalCheckBoxStyle}"
                          IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                          VerticalAlignment="Center" Margin="0,0,20,4"/>
                <Button Content="All" Command="{Binding SelectAllRunItemsCommand}"
                        FontSize="{Binding FontSize, ElementName=RunAllFlatsCheckBox}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                        Margin="0,0,4,4" Padding="8,3"/>
                <Button Content="None" Command="{Binding SelectNoRunItemsCommand}"
                        FontSize="{Binding FontSize, ElementName=RunAllFlatsCheckBox}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                        Margin="0,0,14,4" Padding="8,3"/>
                <Button Content="Run Selected" Command="{Binding RunSelectedBatchCommand}"
                        FontSize="{Binding FontSize, ElementName=RunAllFlatsCheckBox}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                        Margin="0,0,6,4" Padding="8,3"/>
                <Button Content="Stop" Command="{Binding StopCommand}"
                        FontSize="{Binding FontSize, ElementName=RunAllFlatsCheckBox}"
                        IsEnabled="{Binding IsRunning}" Margin="0,0,20,4" Padding="8,3"/>

                <!-- ROUND 67 - "Pause for cover swap": for a panel with no motorized cover (see
                     SmartCalSettings.PauseForCoverSwap for the full explanation), pauses a Flats capture
                     both right before it starts and right after it finishes so the user has time to swap
                     the physical panel for a cap and back. Placed here (not just the Options page) so
                     it's visible right where a run is started; both read/write the same stored value. -->
                <CheckBox Content="Pause for cover swap" IsChecked="{Binding PauseForCoverSwap}"
                          Style="{StaticResource SmartCalCheckBoxStyle}"
                          IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                          VerticalAlignment="Center" Margin="0,0,14,4"/>

                <!-- ROUND 72 - "Open cover after run complete": for a MOTORIZED flat-panel cover only (see
                     SmartCalSettings.OpenCoverAfterRun for the full explanation). Off by default - the
                     cover stays closed once a run ends - so this is purely opt-in: check it if you want
                     the cover to reopen automatically instead. Unrelated to "Pause for cover swap" to its
                     left, which is about a manual panel/cap swap, not a motorized cover. -->
                <CheckBox Content="Open cover after run complete" IsChecked="{Binding OpenCoverAfterRun}"
                          Style="{StaticResource SmartCalCheckBoxStyle}"
                          IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                          VerticalAlignment="Center" Margin="0,0,0,4"/>
            </WrapPanel>
        </Border>

        <!-- ROUND 67 - shown only while a PauseForCoverSwapAsync call is waiting for Continue (see
             SmartCalFramesVM.IsAwaitingCoverSwap). Its own Auto row (Grid.Row="1") right below the Run
             All strip, ahead of everything else - a real grid row rather than overlaying the strip
             above, so it can never visually collide with it. Collapsed (zero height) whenever no pause
             is in progress, so it costs no space the rest of the time. Deliberately loud (bright
             background, bold black text) since this is the one moment the run is silently doing nothing
             until a human acts. Background #FFFF0000 (Round 71's final saturated red, after Round 70's
             lighter #FFEF9A9A and the original amber #FFB58900) - this exact color is also used by the
             sequencer's own pause dialog (Templates/SmartCalDataTemplates.xaml's CoverSwapDialogResult
             template) so both surfaces match. -->
        <Border Grid.Row="1" Margin="0,0,0,8" Padding="6,4" Background="#FFFF0000"
                Visibility="{Binding IsAwaitingCoverSwap, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Continue" Command="{Binding ContinueAfterCoverSwapCommand}"
                        Margin="8,0,0,0" Padding="10,3" FontWeight="Bold"/>
                <TextBlock Text="{Binding CoverSwapMessage}" TextWrapping="Wrap" FontWeight="Bold"
                           Foreground="Black" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ROUND 36 - "Run" (flats) and "Flat Darks" now live as two tabs in the same panel, per
             explicit direction, instead of a second dockable panel or a sequencer-only feature. Both
             tabs share the StatusText/RunLog area - one running log regardless of which tab started it,
             same as a manually-started flats run and a sequencer-driven one already share this panel's
             log (see SmartCalFramesVM.ClearForExternalRun/AppendExternalStatus). -->
        <!-- ROUND 80 added a SelectedIndex TwoWay binding here so the shared histogram could be hidden
             specifically on the Dark Frames tab (which had its own embedded copy at the time). ROUND 83
             removed that whole per-tab-histogram design (see the Round 83 note on the shared histogram
             Border further down) - there is now exactly ONE histogram, shared and identically placed
             across all four tabs, so nothing needs to know which tab is selected any more. Plain
             TabControl, no SelectedIndex binding.

             ROUND 91 - moved to Grid.Row="2" (was "1"). See the Round 91 note on the StatusText+histogram
             Grid, now above this at Grid.Row="1", for why: after three straight rounds of
             VerticalAlignment="Top" fixes to that row's own INTERNAL alignment failed to resolve "still
             not at the top of the frame," this round questions a different assumption instead - that
             row's position in the OUTER row order, not its internal alignment. It used to sit at
             Grid.Row="2", entirely BELOW this whole TabControl (i.e. below every tab's own content,
             however tall that happens to be) - never actually "high" in any tab's visible area no matter
             how it was internally aligned. Swapping the two rows puts the histogram immediately below the
             Run All strip, at the actual top of the panel, before any tab content at all. -->
        <TabControl Grid.Row="3" Margin="0,0,0,8" Background="Transparent" BorderThickness="0">
            <TabItem Header="Run Flats" Style="{StaticResource SmartCalTabItemStyle}">
                <!-- ROUND 86 - hover tooltip added, per explicit request: "why not use text that pops up
                     when you hover over the tabs for run flats, flat darks, etc., rather than fixed text
                     that always appears. The user need not read it every time and that will save a lot of
                     vertical space." This tab never had a static description TextBlock the way the other
                     three did (its Grid.Row="1" FilterDefaultsSummary below is live per-filter DATA, not
                     help text, so it stays visible rather than moving into a tooltip) - this ToolTip is new
                     content, written to match the other three tabs' tooltips for a consistent hover-help
                     experience across all four. See the Flat Darks/Bias Frames/Dark Frames TabItems below
                     for the matching change on tabs that DID have a static description. -->
                <TabItem.ToolTip>
                    <ToolTip>
                        <TextBlock MaxWidth="380" TextWrapping="Wrap"
                                   Text="Self-correcting flat capture: for each filter, searches exposure (and, if needed, brightness) live until the target ADU is reached, then keeps capturing frames until enough have converged within the stability threshold set on the Options page. Use the &quot;Filter:&quot; dropdown and Adaptive/Min/Max controls above to configure per-filter frame counts; use &quot;Capture flats&quot; below to run just the selected filter, or the Run All strip above to run every filter in the wheel."/>
                    </ToolTip>
                </TabItem.ToolTip>
                <!-- ROUND 47 - per explicit user direction: "Frames per filter" + "Adaptive (advanced)"
                     moved up to the Run All strip above (Grid.Row="0" of the outer Grid) - the row that
                     used to hold them here is gone. Filter dropdown, the filter-defaults summary text, and
                     the Min/Max/note reveal (still driven by the SAME FlatAdaptiveMode binding, now
                     toggled from the strip above) were explicitly told to stay untouched, so they're
                     unchanged below - only renumbered since rows were removed/added since.

                     Round 47 ALSO deleted this tab's own "Run this filter"/"Run all filters"/"Stop"
                     button row outright, on the assumption that "Run Selected"/"Stop" on the Run All strip
                     above covered the same ground - flagged at the time as ONE REAL CAPABILITY LOSS (that
                     old button could run just the single filter picked in the dropdown above; the Run All
                     strip's "Run Selected" always runs FLATS ACROSS ALL FILTERS, same as "Run all filters"
                     did - RunSelectedBatchAsync -> RunAsync(allFilters:true, standalone:false)), but left
                     unfixed at the time since nothing had explicitly asked for it back yet.

                     ROUND 66 - RESTORED, per explicit report that this was more than a discoverability
                     gap: "Run selected runs ALL filters. No way to just run a single filter. It needs a
                     Capture Flats button like the others." See the "Capture flats"/Stop button pair at the
                     bottom of this tab's Grid (Grid.Row="3", added this round) and RunFlatsCommand ->
                     RunAsync(allFilters:false) in SmartCalFramesVM - the exact same allFilters:false path
                     the original (Round 59/61-deleted) RunSelectedCommand used to call, just under a name
                     that doesn't collide with RunSelectedBatchCommand now that both exist side by side. -->
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ROUND 52 - reported "still is backwards" after Round 51's notification fix, then
                         clarified precisely: unchecked was popping Min/Max up on the NEXT LINE
                         (left-aligned), which read as the reveal being tied to the wrong state AND as
                         a jarring layout jump. Two changes:
                         1) Min/Max (and the note) moved onto THIS SAME ROW, to the right of the Adaptive
                            checkbox, instead of a separate row below - "have the min/max pop up to the
                            right of the checkbox like the others so it doesn't move" - no more vertical
                            line-jump when toggling.
                         2) Every reveal Visibility (Frames-per-filter AND Min/Max) now binds to
                            {Binding IsChecked, ElementName=FlatAdaptiveCheckBox} instead of the VM's
                            FlatAdaptiveMode. FlatAdaptiveMode is a DERIVED property (Min != Max) that
                            depends on RaisePropertyChanged being raised correctly from three different
                            setters (FlatFrameCount/FlatMinFramesPerFilter/FlatMaxFramesPerFilter) -
                            Round 51 fixed one gap in that chain, but binding the reveal directly to the
                            checkbox's own IsChecked removes the whole class of "these two bindings can
                            disagree" bug: both now read the exact same DependencyProperty at the exact
                            same moment, with no VM round-trip in between. IsChecked itself still writes
                            through to FlatAdaptiveMode via its own TwoWay binding, so persistence is
                            unchanged - only what drives the on-screen reveal changed. -->
                    <!-- ROUND 53 - "that really doesn't work... Put the adaptive checkmark where it is
                         when checked and fix it at that location... so the adaptive checkbox doesn't
                         move when checked but the min/max and the frames per filter just change
                         places." Root cause of the movement: Frames-per-filter used to sit BEFORE the
                         checkbox in this same horizontal StackPanel - collapsing it (when checked) let
                         everything after it, including the checkbox, slide left to fill the gap. Fix:
                         reordered so NOTHING before the checkbox ever changes width (just Filter: +
                         ComboBox, always present) - the checkbox now has a fixed position no matter what.
                         Frames-per-filter and Min/Max both moved to AFTER the checkbox, in the same
                         mutually-exclusive Visibility pair as before, so they swap places in that one
                         slot without ever touching the checkbox's own position. -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="140" ItemsSource="{Binding KnownFilters}"
                                  SelectedItem="{Binding SelectedFilter}"
                                  IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"/>
                        <CheckBox x:Name="FlatAdaptiveCheckBox" Content="Adaptive (advanced)" IsChecked="{Binding FlatAdaptiveMode}"
                                  Style="{StaticResource SmartCalCheckBoxStyle}"
                                  IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                                  VerticalAlignment="Center" Margin="16,0,16,0"/>
                        <TextBlock Text="Frames per filter:" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Visibility="{Binding IsChecked, ElementName=FlatAdaptiveCheckBox, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <TextBox Width="42" Text="{Binding FlatFrameCount}"
                                 IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                                 Visibility="{Binding IsChecked, ElementName=FlatAdaptiveCheckBox, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Min:" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Visibility="{Binding IsChecked, ElementName=FlatAdaptiveCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBox Width="45" Text="{Binding FlatMinFramesPerFilter}"
                                 IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                                 Visibility="{Binding IsChecked, ElementName=FlatAdaptiveCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="Max:" VerticalAlignment="Center" Margin="10,0,4,0"
                                   Visibility="{Binding IsChecked, ElementName=FlatAdaptiveCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBox Width="45" Text="{Binding FlatMaxFramesPerFilter}"
                                 IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                                 Visibility="{Binding IsChecked, ElementName=FlatAdaptiveCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="{Binding FilterDefaultsSummary}" TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.8"/>

                    <TextBlock Grid.Row="2" Text="Stack stability threshold on the Options page controls early-stop within this range."
                               TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,0,0,8"
                               Visibility="{Binding IsChecked, ElementName=FlatAdaptiveCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- ROUND 66 - RESTORED, per explicit report ("Run selected runs ALL filters. No way
                         to just run a single filter. It needs a Capture Flats button like the others").
                         Every other tab (Flat Darks/Bias Frames/Dark Frames) has always had its own
                         "Capture X"/Stop button pair right here; Round 47 deleted this tab's equivalent on
                         the mistaken assumption that the Run All strip's "Run Selected" button covered the
                         same ground - it doesn't, since that button always runs every filter in the wheel
                         and can't target just the one picked in the "Filter:" dropdown above. This button
                         captures ONLY that selected filter (RunFlatsCommand -> RunAsync(allFilters:
                         false)), matching how "Capture flat darks"/"Capture bias frames"/"Capture dark
                         frames" each run their own tab's own settings. -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <Button Content="Capture flats" Command="{Binding RunFlatsCommand}"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                                Margin="0,0,6,0" Padding="8,3"/>
                        <Button Content="Stop" Command="{Binding StopCommand}"
                                IsEnabled="{Binding IsRunning}" Padding="8,3"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Flat Darks" Style="{StaticResource SmartCalTabItemStyle}">
                <!-- ROUND 86 - moved from an always-visible TextBlock (was Grid.Row="0" below) into a
                     hover tooltip on the tab header itself, per explicit request: "why not use text that
                     pops up when you hover over the tabs for run flats, flat darks, etc., rather than fixed
                     text that always appears. The user need not read it every time and that will save a lot
                     of vertical space." Content is unchanged from the old TextBlock's Text, word for word -
                     only where it lives changed. Removing that row also meant renumbering every remaining
                     Grid.Row below (was 1/2/3, now 0/1/2) and dropping the Grid's now-unneeded 4th
                     RowDefinition. -->
                <TabItem.ToolTip>
                    <ToolTip>
                        <TextBlock MaxWidth="380" TextWrapping="Wrap"
                                   Text="Captures dark frames matched to each filter's stored flat exposure - one dark group per unique exposure, so filters sharing an exposure share one group. Uses the current camera gain/offset and bin1x1, same as flats. The flat panel's light is turned off before capturing; if your panel has a motorized cover it's closed automatically first and reopened once the run finishes (panels without a motorized cover are unaffected)."/>
                    </ToolTip>
                </TabItem.ToolTip>
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Darks per group:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="50" Text="{Binding DarkFramesPerGroup}"
                                  IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"/>
                        <!-- ROUND 57 - button label now reflects what clicking it will do next
                             ("Show Groups" while hidden, "Hide Groups" while shown), per explicit
                             request, instead of a static "Preview groups" that never changed.
                             ROUND 58 FIX - the original Round 57 Style had no BasedOn, so setting it
                             directly on Button.Style replaced NINA's ambient implicit Button style
                             entirely for this one button (setting Style on an element always wins over
                             an implicit style lookup) - it fell back to plain default WPF Button chrome
                             instead of NINA's green action-button look ("Capture flat darks" below never
                             had this problem because it has no local Style at all, so NINA's implicit
                             style still applies to it). BasedOn="{StaticResource {x:Type Button}}" below
                             re-inherits that same ambient green/light-green look - only the Content
                             swap is still this Style's own doing. -->
                        <Button Command="{Binding PreviewDarkGroupsCommand}"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                                Margin="12,0,0,0" Padding="8,3">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Show Groups"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DarkGroupsPreviewVisible}" Value="True">
                                            <Setter Property="Content" Value="Hide Groups"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="{Binding DarkGroupsPreview}" TextWrapping="Wrap"
                               FontFamily="Consolas" FontSize="11" Margin="0,0,0,8"
                               Visibility="{Binding DarkGroupsPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="Capture flat darks" Command="{Binding RunFlatDarksCommand}"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                                Margin="0,0,6,0" Padding="8,3"/>
                        <Button Content="Stop" Command="{Binding StopCommand}"
                                IsEnabled="{Binding IsRunning}" Padding="8,3"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Bias Frames" Style="{StaticResource SmartCalTabItemStyle}">
                <!-- ROUND 86 - moved from an always-visible TextBlock into a hover tooltip, same change and
                     same rationale as the Flat Darks tab above (see its comment). Content unchanged from
                     the old TextBlock's Text; remaining Grid.Row values renumbered 1/2 -> 0/1 and the 3rd
                     (now-unneeded) RowDefinition dropped. -->
                <TabItem.ToolTip>
                    <ToolTip>
                        <TextBlock MaxWidth="380" TextWrapping="Wrap"
                                   Text="Captures a fixed count of bias frames - current camera gain/offset, bin1x1, no filter wheel move. Exposure is not user-set: it's read from the connected camera's own reported minimum exposure at capture time (falls back to the Min Exposure setting from Run Flats only if the camera doesn't report one). The flat panel's light is turned off before capturing, same as Flat Darks; if your panel has a motorized cover it's closed automatically first and reopened once the run finishes (panels without a motorized cover are unaffected)."/>
                    </ToolTip>
                </TabItem.ToolTip>
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Frame count:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="50" Text="{Binding BiasFrameCount}"
                                  IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Content="Capture bias frames" Command="{Binding RunBiasFramesCommand}"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                                Margin="0,0,6,0" Padding="8,3"/>
                        <Button Content="Stop" Command="{Binding StopCommand}"
                                IsEnabled="{Binding IsRunning}" Padding="8,3"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Dark Frames" Style="{StaticResource SmartCalTabItemStyle}">
                <!-- ROUND 86 - moved from an always-visible TextBlock into a hover tooltip, same change and
                     same rationale as the Flat Darks/Bias Frames tabs above (see either's comment). Content
                     unchanged from the old TextBlock's Text; remaining Grid.Row values renumbered 1/2 -> 0/1
                     and the 3rd (now-unneeded) RowDefinition dropped. -->
                <TabItem.ToolTip>
                    <ToolTip>
                        <TextBlock MaxWidth="380" TextWrapping="Wrap"
                                   Text="Captures dark frames matched to each filter's own light-frame settings (not the stored flat exposure, unlike Flat Darks). Set Binning/Frames/Exposure per filter below - a filter left at 0 frames is skipped; exposure must be at least 0.1s once you set a frame count above 0. Filters that agree on both exposure and binning share one capture pass, using the larger requested frame count. Uses the current camera gain/offset, no filter wheel move. The flat panel's light is turned off before capturing; if your panel has a motorized cover it's closed automatically first and reopened once the run finishes (panels without a motorized cover are unaffected). A summary of what was actually captured per group appears at the top once the run finishes, so a failed group is easy to spot."/>
                    </ToolTip>
                </TabItem.ToolTip>
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ROUND 80 rebuilt this per-filter table as a column-aligned Grid with ONE header
                         row (Filter/Bin/Frames/Exp(s)) instead of the old StackPanel-per-row approach that
                         re-typed "Bin:"/"Frames:"/"Exposure (s):" as a label on EVERY row - that repetition
                         was most of what made each row wide.

                         ROUND 80 also embedded a second histogram directly beside this table, in the width
                         the header-row rework freed up - REMOVED in ROUND 83. Per explicit request, the
                         histogram is now ONE shared element, identically placed and sized on all four tabs
                         (see the shared area below the TabControl, further down this file).

                         ROUND 85 REPLACES Round 80's one-filter-per-row table entirely, per explicit
                         report: "on dark frames, you have one filter per row. Instead, you could put four
                         on one row and three on another (with room for one more) thus bringing the entire
                         display below up-and enlarging the log/image frames." One filter per row meant N
                         filters cost N rows of vertical height, most of it wasted - the table only ever
                         used a narrow slice of this tab's real available width (see the screenshot: the
                         table sat at the left edge with a large empty gap to its right). Since the
                         TabControl's content height is Auto-sized and the log/image row below is the only
                         "*" row in the whole panel (Round 84), every pixel this tab's OWN content saves
                         vertically is a pixel handed straight to the log/image row - exactly the mechanism
                         behind "enlarging the log/image frames."

                         Fix: each filter is now a small self-contained "card" (name + Bin/Frames/Exp inline,
                         each with its own short label since there's no longer one shared header row to
                         align against - a WrapPanel's items don't stay column-aligned across wrapped lines,
                         so a shared header above them would only ever line up with the FIRST row) laid out
                         in a WrapPanel instead of one item per line. At a typical docked width this fits
                         about 4 cards per row, wrapping the rest onto a second row - for a 7-filter wheel
                         (Lum/Red/Green/Blue/Ha/OIII/SII) that's 4 + 3, matching the exact split described
                         in the report, instead of 7 stacked rows. A narrower docked panel simply wraps to
                         fewer cards per row (down to 1) rather than clipping anything - the WrapPanel
                         degrades gracefully instead of assuming a specific panel width. -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DarkFrameRows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FF3E4B54" BorderThickness="1" Margin="0,0,6,6" Padding="6,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding FilterName}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Bin" FontSize="9" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                    <ComboBox Width="38" ItemsSource="{StaticResource BinningOptions}"
                                                              SelectedItem="{Binding BinningFactor}"
                                                              IsEnabled="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanConverter}}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding StringFormat={}{0}x}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBlock Text="Fr" FontSize="9" Opacity="0.6" VerticalAlignment="Center" Margin="6,0,2,0"/>
                                                    <TextBox Width="30" Text="{Binding FrameCount, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEnabled="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanConverter}}"/>
                                                    <TextBlock Text="Exp" FontSize="9" Opacity="0.6" VerticalAlignment="Center" Margin="6,0,2,0"/>
                                                    <TextBox Width="40" Text="{Binding ExposureSeconds, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEnabled="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanConverter}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Content="Capture dark frames" Command="{Binding RunDarkFramesCommand}"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                                Margin="0,0,6,0" Padding="8,3"/>
                        <Button Content="Stop" Command="{Binding StopCommand}"
                                IsEnabled="{Binding IsRunning}" Padding="8,3"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ROUND 93 - the per-frame histogram square (Rounds 77-92's whole saga of position/size/missing-
             curve fixes - see kb.txt for that full history) was removed per explicit request: "if we
             delete the histogram will we gain any more vertical space where the objects below it can move
             up? ... Yes, I don't think it's really that useful anyway." It was a fixed 75x75 square sharing
             this Auto-height row with StatusText; since an Auto row sizes to its tallest child, the square
             (taller than StatusText's own 1-2 wrapped lines) was what set this row's height. Removing it
             lets this row shrink to whatever StatusText itself actually needs, and the log/image row below
             (Grid.Row="5", the outer Grid's own "*" row - it takes whatever height is left over) gains that
             freed space directly.

             ROUND 96 - StatusText's MaxWidth="220" (left over from Round 90, back when this row's second
             column held the histogram and StatusText needed to stay narrow to leave it room) was never
             removed when Round 93 deleted that second column above, so this text kept wrapping at 220px
             even though nothing else shares the row with it any more - reported directly: "It no longer
             need to unless it extends to the right of this window." Dropped MaxWidth (and the now-
             redundant HorizontalAlignment="Left", which only mattered for capping within that old 220px
             box) so the TextBlock uses the full width the Grid actually gives it and only wraps once a
             line would run past the panel's real right edge, same as any other unconstrained wrapping
             TextBlock in this file. -->
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" TextWrapping="Wrap" FontWeight="SemiBold"
                   Margin="0,0,0,8" VerticalAlignment="Top"/>

        <Separator Grid.Row="4" Margin="0,0,0,8"/>

        <!-- ROUND 69 - two columns: the running log (always present) and, when the Options page's "Show
             captured image" toggle is on, the most recently captured frame at the same width next to it.
             ShowImagePreview is bound via BoolToGridLengthConverter so the image column actually
             collapses to 0 width when off - the log then has the row to itself, exactly as before this
             round - rather than just hiding the image and leaving dead blank space.

             ROUND 84 - this Grid used to also hold StatusText and the shared histogram (Round 83). Both
             moved up to their own row above the Separator (Grid.Row="2", see above) - "above the horizontal
             line above the log" - so this Grid is back to holding just the log and image, maximizing their
             shared vertical space. Only one row needed now, so the RowDefinitions/per-row Grid.Row values
             Round 83 added here are removed again. -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding ShowImagePreview, Converter={StaticResource BoolToGridLengthConverter}}"/>
            </Grid.ColumnDefinitions>

            <!-- Running log: one line per search attempt and per accepted (keeper) frame, exposure and
                 ADU included - this is the "does NINA show what the exposure and ADU is after taking the
                 exposure" running log. Newest entry is added at the end; ScrollIntoView keeps it visible
                 without the user having to scroll manually during a run. Styled with NINA's own default
                 dark background (#273238, sampled directly from the app rather than guessed) and white
                 text, matching NINA's own look instead of the default grey-on-white ListBox.

                 ROUND 82 - reported: "for the display log is it possible to word wrap each line rather
                 than having to scroll?" Two changes needed together - either alone doesn't work:
                 1) HorizontalScrollBarVisibility changed from "Auto" to "Disabled" - as long as
                    horizontal scrolling is allowed, the ListBox's internal panel gives each item
                    unlimited width to lay out on one line (that's the whole point of a horizontal
                    scrollbar), so TextWrapping never had anything to wrap AGAINST. Disabling horizontal
                    scroll constrains items to the ListBox's actual width, which is what makes wrapping
                    possible at all.
                 2) An explicit ItemTemplate is now needed because RunLog is a plain
                    ObservableCollection<string> - without one, ListBox's default string rendering doesn't
                    expose a TextWrapping property to set. The TextBlock below binds directly to the
                    string item ({Binding} with no path) and sets TextWrapping="Wrap".
                 VerticalScrollBarVisibility stays "Auto" - wrapped lines make the log taller per entry,
                 not wider, so vertical scrolling is still exactly what's needed once entries exceed the
                 visible height. -->
            <ListBox Grid.Column="0" x:Name="RunLogListBox" ItemsSource="{Binding RunLog}"
                     FontFamily="Consolas" FontSize="11"
                     Background="#FF273238" Foreground="White" BorderBrush="#FF273238"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="#FF273238"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF3E4B54"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- ROUND 69 - most recently captured frame, updated after every capture (SmartCalFramesVM.
                 LastCapturedImage). Same width as the log (both "*" columns above). ROUND 73 - now a
                 nested Grid instead of a bare Border: a small zoom toolbar on top (mirrors NINA's own
                 image-view toolbar - see this round's discussion screenshot) and the zoomable/scrollable
                 image below it. Background matches the log's own dark background so an empty/not-yet-
                 captured preview reads as part of the same panel rather than a stray white box.

                 ROUND 83 - this Grid used to have a third row holding a histogram plot underneath the
                 image ("the histogram similar to the Flat Wizard display", Round 73). That histogram moved
                 out to its own row, shared across all four tabs - just toolbar + image here now.

                 ROUND 84 - the histogram (and StatusText) moved again, from Round 83's row below the
                 Separator to a new row ABOVE it (Grid.Row="2" of the outer Grid - see further up this
                 file) - this Grid's own Grid.Row (in the outer log/image Grid) dropped from "2" to "0"
                 since that outer Grid no longer has any other rows to share. -->
            <Grid Grid.Column="1" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ROUND 73 - zoom toolbar. ImageZoom is a plain multiplier (1.0 = 100%) bound to the
                     ScaleTransform below; ZoomIn/ZoomOut multiply by 1.25 each click (clamped [0.25x,
                     8x] in the VM), Reset returns to 1.0. ImageZoomPercentText gives the live "125%"-
                     style readout next to the buttons.

                     ROUND 74 - added the "Fit" button per explicit report that manual zoom percentages
                     couldn't reliably show the whole frame ("Even at 25% it still too large to fit inside
                     the window"). Fit is now also the default mode (VM's FitToWindow starts true), so a
                     freshly captured frame is fully visible with no button presses needed - the +/-/1:1
                     buttons remain for zooming into detail afterward, and each one explicitly drops back
                     out of Fit mode (see the VM), since a manual multiplier and "always fill the
                     available space" can't both size the same Image at once. -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="Fit" Command="{Binding FitToWindowCommand}" Padding="8,2" ToolTip="Scale the whole frame to fill the available space"/>
                    <Button Content="-" Command="{Binding ZoomOutCommand}" Padding="8,2" MinWidth="26" Margin="8,0,0,0" ToolTip="Zoom out"/>
                    <Button Content="+" Command="{Binding ZoomInCommand}" Padding="8,2" MinWidth="26" Margin="4,0,0,0" ToolTip="Zoom in"/>
                    <Button Content="1:1" Command="{Binding ResetZoomCommand}" Padding="8,2" Margin="4,0,0,0" ToolTip="Reset zoom to 100%"/>
                    <TextBlock Text="{Binding ImageZoomPercentText}" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.8"/>
                </StackPanel>

                <!-- ROUND 74 - two mutually-exclusive display modes sharing this same cell, switched by
                     FitToWindow's Visibility bindings (only one is ever visible at a time):

                     1) Fit mode (default): the Image sits directly in a Viewbox with
                        Stretch="Uniform" + StretchDirection="Both", which scales the ENTIRE frame - up
                        or down, whichever is needed - to exactly fill whatever space this Border actually
                        has right now. This is the fix for the reported bug: a fixed zoom PERCENTAGE (the
                        old always-on ScrollViewer+ScaleTransform below) has no way to know the real pixel
                        size of the captured frame vs. the real size of the docked panel, so a hardcoded
                        25% could still be larger than the panel; a Viewbox computes the correct scale
                        from the actual available size instead of guessing at a percentage.

                     2) Manual-zoom mode (unchanged from Round 73, just now conditional): the same
                        ScrollViewer + ScaleTransform as before, for examining detail once the whole frame
                        has already been seen - Stretch="Uniform" is kept on this Image too so it still
                        renders at a sane starting size before ImageZoom scales it further, and the
                        ScrollViewer lets you pan once zoomed past the visible area. -->
                <!-- ROUND 93 - reported: "the image needs to be placed as high to the right of the log as
                     it can go. Just under the horizontal line." This Border already fills the full "*"
                     row height to match the log's own height (deliberate - keeps the two dark panels the
                     same visual height), and it already sits immediately below the Separator above.
                     What wasn't pinned to the top was the CONTENT inside it: a Viewbox with more available
                     height than its scaled child needs centers that child vertically by default (the same
                     "explicit/constrained size + default Stretch/Center behavior floats away from the top"
                     class of WPF gotcha already hit and fixed for the histogram square in Rounds 88/89) -
                     so on anything shorter than a very tall docked panel, the captured frame appeared to
                     float in the middle of this column instead of sitting flush under the separator like
                     the log's own text does. Fix: VerticalAlignment="Top" on the Viewbox itself (Fit mode)
                     so the scaled image renders starting at the top of the available space, with any
                     leftover room pushed below it instead of split above and below. The manual-zoom
                     ScrollViewer branch already anchors its content to the top-left by default (a
                     ScrollViewer never centers), so it needed no change. -->
                <Border Grid.Row="1" Background="#FF273238" BorderBrush="#FF273238" BorderThickness="1">
                    <Grid>
                        <Viewbox Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Top"
                                 Visibility="{Binding FitToWindow, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Image Source="{Binding LastCapturedImage}" RenderOptions.BitmapScalingMode="Fant"/>
                        </Viewbox>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding FitToWindow, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <Image Source="{Binding LastCapturedImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant">
                                <Image.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding ImageZoom}" ScaleY="{Binding ImageZoom}"/>
                                </Image.LayoutTransform>
                            </Image>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
